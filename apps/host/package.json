{
  "name": "@homebase/host",
  "version": "0.0.1",
  "private": true,
  "description": "Homebase Host: the local control plane that runs provider adapters and serves the PWA",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "homebase": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@homebase/adapter-claude": "0.0.1",
    "@homebase/adapter-opencode": "0.0.1",
    "@homebase/adapter-sdk": "0.0.1",
    "@homebase/protocol": "0.0.1",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
