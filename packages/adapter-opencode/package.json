{
  "name": "@homebase/adapter-opencode",
  "version": "0.0.1",
  "description": "Homebase adapter for the OpenCode server API",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@homebase/adapter-sdk": "0.0.1",
    "@homebase/protocol": "0.0.1",
    "zod": "^4.6.5"
  }
}
